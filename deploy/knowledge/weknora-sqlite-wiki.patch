@@ -0,0 +1,64 @@
+package repository
+
+import (
+	"context"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+)
+
+func TestLiteWikiSQLiteCompatibility(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, _ := db.DB()
+	sqlDB.SetMaxOpenConns(1)
+	defer sqlDB.Close()
+	err = db.Exec(`CREATE TABLE wiki_pages(id TEXT, knowledge_base_id TEXT, slug TEXT, title TEXT, page_type TEXT, status TEXT, aliases TEXT, out_links TEXT, source_refs TEXT, content TEXT, summary TEXT, updated_at DATETIME, deleted_at DATETIME)`).Error
+	if err != nil {
+		t.Fatal(err)
+	}
+	rows := []struct{ kb, slug, title, alias, refs string }{
+		{"kb-a", "nepheline", "霞石", "[\"nepheline\"]", "[\"doc-1|Mineralogy\"]"},
+		{"kb-a", "quartz", "石英", "[\"quartz\"]", "[\"doc-2\"]"},
+		{"kb-b", "secret", "霞石", "[]", "[\"doc-1\"]"},
+	}
+	for _, r := range rows {
+		if err = db.Exec(`INSERT INTO wiki_pages VALUES(?,?,?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,NULL)`, r.slug, r.kb, r.slug, r.title, "entity", "published", r.alias, "[]", r.refs, "矿物平衡资料", "测试摘要").Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	repo := &wikiPageRepository{db: db}
+	ctx := context.Background()
+	similar, err := repo.FindSimilarPages(ctx, "kb-a", "NEPHELINE", nil, 5)
+	if err != nil || len(similar) != 1 || similar[0].Slug != "nepheline" {
+		t.Fatalf("alias dedup: %v %v", similar, err)
+	}
+	exact, err := repo.FindSimilarPages(ctx, "kb-a", "霞石", nil, 5)
+	if err != nil || len(exact) != 1 || exact[0].Slug != "nepheline" {
+		t.Fatalf("Chinese title: %v %v", exact, err)
+	}
+	pages, err := repo.ListBySourceRef(ctx, "kb-a", "doc-1")
+	if err != nil || len(pages) != 1 || pages[0].Slug != "nepheline" {
+		t.Fatalf("source prefix: %v %v", pages, err)
+	}
+	slugs, err := repo.ListSlugsBySourceRef(ctx, "kb-a", "doc-2")
+	if err != nil || len(slugs) != 1 || slugs[0] != "quartz" {
+		t.Fatalf("source ID: %v %v", slugs, err)
+	}
+	pages, err = repo.ListBySourceRef(ctx, "kb-a", "doc-%")
+	if err != nil || len(pages) != 0 {
+		t.Fatalf("source wildcard escaped: %v %v", pages, err)
+	}
+	pages, err = repo.Search(ctx, "kb-a", "矿物", 10)
+	if err != nil || len(pages) != 2 {
+		t.Fatalf("SQLite content search: %v %v", pages, err)
+	}
+	if wikiTrigramSimilarity("霞石", "霞石") != 1 || wikiTrigramSimilarity("quartz", "nepheline") >= .1 {
+		t.Fatal("trigram similarity semantics")
+	}
+	_ = types.WikiPageTypeEntity
+}
