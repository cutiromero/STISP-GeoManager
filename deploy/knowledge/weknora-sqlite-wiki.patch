+package repository
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"unicode"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// SQLite JSON1 implements both source formats without PostgreSQL casts or
+// wildcard ambiguity: exact knowledge ID, or knowledge ID followed by '|'.
+const wikiSQLiteSourcePredicate = "EXISTS (SELECT 1 FROM json_each(COALESCE(source_refs, '[]')) WHERE value = ? OR instr(value, ?) = 1)"
+
+// Lite has no pg_trgm. Score a bounded, KB-scoped candidate set in Go, keeping
+// PostgreSQL's indexed path unchanged. This is a merge prefilter, not a decision:
+// the existing Wiki semantic merge and source attribution still run afterward.
+func (r *wikiPageRepository) findSimilarPagesSQLite(ctx context.Context, kbID, query string, pageTypes []string, limit int) ([]*types.WikiPageLite, error) {
+	var rows []types.WikiPageLite
+	err := r.db.WithContext(ctx).Model(&types.WikiPage{}).
+		Select("slug, title, page_type, status, aliases, out_links").
+		Where("knowledge_base_id = ? AND page_type IN ? AND status <> ?", kbID, pageTypes, types.WikiPageStatusArchived).
+		Order("updated_at DESC, slug ASC").Limit(2000).Scan(&rows).Error
+	if err != nil {
+		return nil, err
+	}
+	type scored struct {
+		page  *types.WikiPageLite
+		score float64
+	}
+	matches := make([]scored, 0)
+	for i := range rows {
+		page := &rows[i]
+		score := wikiTrigramSimilarity(query, page.Title)
+		for _, alias := range page.Aliases {
+			if value := wikiTrigramSimilarity(query, alias); value > score {
+				score = value
+			}
+		}
+		if score >= 0.1 {
+			matches = append(matches, scored{page, score})
+		}
+	}
+	sort.Slice(matches, func(i, j int) bool {
+		if matches[i].score == matches[j].score {
+			return matches[i].page.Slug < matches[j].page.Slug
+		}
+		return matches[i].score > matches[j].score
+	})
+	if len(matches) > limit {
+		matches = matches[:limit]
+	}
+	out := make([]*types.WikiPageLite, len(matches))
+	for i, match := range matches {
+		out[i] = match.page
+	}
+	return out, nil
+}
+
+func wikiTrigramSimilarity(a, b string) float64 {
+	grams := func(value string) map[string]bool {
+		out := map[string]bool{}
+		for _, word := range strings.FieldsFunc(strings.ToLower(value), func(r rune) bool { return !unicode.IsLetter(r) && !unicode.IsNumber(r) }) {
+			runes := []rune("  " + word + " ")
+			for i := 0; i+3 <= len(runes); i++ {
+				out[string(runes[i:i+3])] = true
+			}
+		}
+		return out
+	}
+	x, y := grams(a), grams(b)
+	intersection := 0
+	for gram := range x {
+		if y[gram] {
+			intersection++
+		}
+	}
+	union := len(x) + len(y) - intersection
+	if union == 0 {
+		return 0
+	}
+	return float64(intersection) / float64(union)
+}
