# Copy to /etc/geomanager-sync/config.env and chmod 600.
# No token belongs in Git. Put the token contents in the files referenced below.
GEOMANAGER_REPOSITORY=spAurora/GeoManager
GEOMANAGER_IMAGE=ghcr.io/spaurora/geomanager
GEOMANAGER_CONTAINER=geomanager
GEOMANAGER_HOST_PORT=6007
GEOMANAGER_CONTAINER_PORT=8000
GEOMANAGER_CONFIG_DIR=/srv/geomanager/config
GEOMANAGER_DATA_VOLUME=huyang-data
GEOMANAGER_HEALTH_URL=http://127.0.0.1:6007/api/health/

# Use the server's existing domestic proxy. Leave blank only when direct access
# has been tested successfully; a failed preflight never changes the service.
GEOMANAGER_PROXY_URL=http://127.0.0.1:10808

GEOMANAGER_GITHUB_TOKEN_FILE=/etc/geomanager-sync/github-token
GEOMANAGER_GHCR_USERNAME=spAurora
GEOMANAGER_GHCR_TOKEN_FILE=/etc/geomanager-sync/ghcr-token
