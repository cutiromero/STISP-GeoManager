{
  "get_research_workflow": {
    "version": 1,
    "description": "按名称、代码或版本编号读取已发布科研业务流的行动建议、资料用途、算子和交付方向。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "已发布业务流的名称或代码"
        }
      },
      "additionalProperties": false
    }
  },
  "submit_research_compute": {
    "version": 1,
    "description": "向当前项目计算中心提交一个已发布算子。按算子清单提供输入键、资源编号和参数，使用返回的 taskId 跟进结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "inputs": {
          "type": "object",
          "additionalProperties": true
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "fieldMappings": {
          "type": "object",
          "additionalProperties": true
        },
        "retryOf": {
          "type": "string",
          "format": "uuid",
          "description": "本会话中需要继续适配的任务编号"
        },
        "operatorEdits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 240
              },
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "after": {
                "type": "string",
                "maxLength": 12000
              }
            },
            "required": ["file", "before", "after"],
            "additionalProperties": false
          },
          "description": "把发布包 Python 文件中唯一匹配的 before 文本替换为 after，生成此次执行副本"
        },
        "reuseOperatorCopyFrom": {
          "type": "string",
          "format": "uuid",
          "description": "复用本会话另一任务的 Python 修改，按所选发布包重新匹配该修改"
        }
      },
      "required": ["versionId", "name", "inputs"],
      "additionalProperties": false
    }
  },
  "get_research_compute": {
    "version": 1,
    "description": "查询本会话提交的计算任务状态、执行进度和成果编号。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "等待计算到达终态的最长秒数"
        }
      },
      "required": ["taskId"],
      "additionalProperties": false
    }
  },
  "read_research_output": {
    "version": 1,
    "description": "按成果编号读取本会话的计算结果。表格支持分页读取，栅格提供数值分布，地图与文件可从结果链接打开。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "outputId": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "taskId": {
          "type": "string",
          "format": "uuid",
          "description": "所选成果对应的计算任务编号"
        }
      },
      "required": ["outputId"],
      "additionalProperties": false
    }
  },
  "register_research_output": {
    "version": 1,
    "description": "将本会话的计算成果登记为当前项目数据，供后续算子和地图使用。查询计算任务可查看导入进度和资源编号。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "outputId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "taskId": {
          "type": "string",
          "format": "uuid",
          "description": "所选成果对应的计算任务编号"
        }
      },
      "required": ["outputId"],
      "additionalProperties": false
    }
  },
  "list_business_flows": {
    "description": "查找当前项目已发布的科研业务流。按名称搜索后，用版本编号读取科研路径。"
  },
  "summarize_resource_catalog": {
    "description": "统计当前可用的登记数据和计算成果数量、类型与大小。按关键词和来源筛选。"
  },
  "read_knowledge_document": {
    "description": "按知识检索返回的 documentId 分页读取文献原文。用 nextOffset 继续阅读全文。"
  },
  "check_knowledge_constraints": {
    "description": "用项目知识规则核对结构化事实。返回符合、冲突及需要补充资料的问题。"
  },
  "get_map_data_profile": {
    "description": "查看地图资源的类别、数量、建议颜色和项目配色规则。矢量可选字段，栅格可选波段。"
  },
  "get_platform_link": {
    "description": "创建当前项目的地图、数据资源、计算中心、知识库或业务流入口。"
  },
  "inspect_research_operator": {
    "version": 1,
    "description": "按算子代码或版本读取发布清单，也可按本会话 taskId 查看实际执行的副本。指定文件和行偏移可继续查阅源码。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string",
          "maxLength": 240
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "源码起始行偏移，从零开始"
        },
        "identifier": {
          "type": "string",
          "maxLength": 120,
          "description": "平台登记的算子代码"
        },
        "taskId": {
          "type": "string",
          "format": "uuid",
          "description": "本会话的计算任务，优先读取该次实际执行的代码"
        }
      },
      "additionalProperties": false
    }
  },
  "list_research_geology_rules": {
    "version": 1,
    "description": "列出当前项目已登记的地质规则表，供逻辑推理算子的 rules 输入选择。结合研究区、版本和知识来源选用。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "prepare_research_geology_changes": {
    "version": 1,
    "description": "根据实际问题编号选择地质工作副本的处置，向用户发出一次确认。获得确认后返回供已发布处置算子使用的 approved_changes 资料编号。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "checkTaskId": {
          "type": "string",
          "format": "uuid"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "issueId": {
                "type": "string",
                "maxLength": 100
              },
              "action": {
                "type": "string",
                "maxLength": 32
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string",
                "maxLength": 160
              }
            },
            "required": ["issueId", "action"],
            "additionalProperties": false
          }
        }
      },
      "required": ["checkTaskId", "actions"],
      "additionalProperties": false
    }
  }
}
