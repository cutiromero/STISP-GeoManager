{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "ignorePatterns": [
    "dist/**",
    "generated/**",
    "src/api/generated/**",
    "src/api/schema.d.ts",
    ".playwright-cli/**",
    "output/**",
    ".cache/**",
    "test-results/**",
    "playwright-report/**",
    "coverage/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  }
}
