{
  "schemaVersion": 2,
  "adapter": "research_flow",
  "skill": {
    "title": "冰川解译",
    "instructions": "分别统计洁净冰川和表碛冰川。找到可比较的上期影像时，说明哪一类面积变了、变了多少。"
  },
  "inputRequirements": [
    {
      "key": "image",
      "label": "本期原始影像",
      "description": "选一幅要分析的冰川原始影像（15 波段 TIFF），不要选彩色分类图。",
      "dataTypes": [
        "raster"
      ],
      "required": true,
      "requiredFields": [],
      "multiple": false
    }
  ],
  "nodes": [
    {
      "id": "interpret",
      "title": "提取冰川",
      "kind": "operator",
      "description": "生成洁净冰川和表碛冰川的分类图。",
      "instruction": "",
      "dependsOn": [],
      "dataRoles": [],
      "inputBindings": {
        "image": {
          "role": "image"
        }
      },
      "contract": {
        "requiredOutputs": [
          {
            "name": "classification",
            "semanticType": "raster"
          }
        ],
        "importOutputs": [
          "classification"
        ]
      }
    },
    {
      "id": "compare",
      "title": "统计面积和变化",
      "kind": "operator",
      "description": "统计本期面积，自动查找可以对比的上期成果。",
      "instruction": "取同样区最近一期可比结果。两期都覆盖的地方才算变化；没有可比前期时只统计本期。",
      "dependsOn": [
        "interpret"
      ],
      "dataRoles": [],
      "inputBindings": {
        "current": {
          "nodeId": "interpret",
          "outputKey": "classification"
        }
      },
      "contract": {
        "requiredOutputs": [
          {
            "name": "areas",
            "semanticType": "table"
          },
          {
            "name": "transitions",
            "semanticType": "table"
          },
          {
            "name": "coverage",
            "semanticType": "table"
          }
        ]
      }
    },
    {
      "id": "handover",
      "title": "整理报告",
      "kind": "result",
      "description": "交付分类图并说明冰川面积。",
      "instruction": "先给本期面积和图表。有上期结果则写明日期、增减及共同覆盖范围；没找到则说明原因。若按整幅统计，注明影像没有缺测标记。",
      "dependsOn": [
        "compare"
      ],
      "dataRoles": []
    }
  ],
  "outputRequirements": [
    "冰川分类图",
    "面积统计和变化报告"
  ]
}
